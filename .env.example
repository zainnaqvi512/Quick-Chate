# Copy to ignored .env; supply your own values securely.
DATABASE_URL=
APP_SECRET=
# Persistent private directory, never inside dist/public.
MEDIA_STORAGE_DIR=
# Use twilio for real SMS. Dev OTP remains forbidden in production.
OTP_PROVIDER=
TEST_OTP=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Explicit country dial-code allowlist; e.g. +92. Also configure Twilio Geo Permissions.
SMS_ALLOWED_PREFIXES=
# Native WebView origins only; no wildcard. Web preview needs no entry.
NATIVE_ORIGINS=capacitor://localhost,https://localhost
# Native build only, e.g. https://quick-chat-preview-production.up.railway.app
VITE_API_ORIGIN=
# Optional STUN and TURN server supporting short-lived REST credentials.
STUN_URL=
TURN_URL=
TURN_SHARED_SECRET=
VITE_GIPHY_API_KEY=
