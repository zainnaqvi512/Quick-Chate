# --- Quick Chat environment example (never commit real secrets) ---

# Database
DATABASE_URL=mysql://user:pass@host:3306/quickchat

# Auth / OTP
APP_SECRET=change-me
JWT_SECRET=change-me
OTP_PROVIDER=dev            # dev | sms
OTP_API_KEY=                # SMS provider key (Twilio/Vonage adapter)
TEST_OTP=                   # optional fixed code for development only

# Object storage (platform-injected in hosted runs)
KIMI_AGENTGW_API_KEY=
KIMI_AGENTGW_BASE_URL=
KIMI_STORAGE_RESOURCE_ID=

# GIF search (optional; UI degrades gracefully without it)
VITE_GIPHY_API_KEY=

# WebRTC
VITE_STUN_URL=stun:stun.l.google.com:19302
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_PASSWORD=
