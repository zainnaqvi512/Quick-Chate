# Copy to ignored .env; supply your own values securely.
DATABASE_URL=
APP_SECRET=
# Persistent private directory, never inside dist/public.
MEDIA_STORAGE_DIR=
# Development phone testing only; production always rejects OTP sign-in.
OTP_PROVIDER=
TEST_OTP=
# Optional STUN and TURN server supporting short-lived REST credentials.
STUN_URL=
TURN_URL=
TURN_SHARED_SECRET=
VITE_GIPHY_API_KEY=
